{
  "name": "@cheloni/monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "examples/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^24",
      "typescript": "^5",
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
      "vite-plus": "latest"
    }
  },
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test -r && vp run build -r",
    "dev": "vp run -r build --watch",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "prepare": "vp config",
    "release": "vp run cheloni#release",
    "release:dry": "vp run cheloni#release:dry",
    "docsgen:examples": "bun run scripts/docsgen-examples.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "bun run docsgen:examples && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "gh-pages -d docs/.vitepress/dist"
  },
  "devDependencies": {
    "gh-pages": "^6.1.1",
    "vite-plus": "catalog:",
    "vitepress": "^2.0.0-alpha.16"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1"
}
